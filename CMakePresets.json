{
    "version": 4,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 23,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/bin/${presetName}"
            }
        },
        {
            "name": "gcc",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "debug-windows-gcc",
            "displayName": "Debug (Windows GCC)",
            "inherits": ["base", "gcc"],
            "binaryDir": "${sourceDir}/build/windows/debug-gcc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release-windows-gcc",
            "displayName": "Release (Windows GCC)",
            "inherits": ["base", "gcc"],
            "binaryDir": "${sourceDir}/build/windows/release-gcc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "debug-linux-gcc",
            "displayName": "Debug (Linux GCC)",
            "inherits": ["base", "gcc"],
            "binaryDir": "${sourceDir}/build/wsl/debug-gcc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release-linux-gcc",
            "displayName": "Release (Linux GCC)",
            "inherits": ["base", "gcc"],
            "binaryDir": "${sourceDir}/build/wsl/release-gcc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug-windows-gcc",
            "configurePreset": "debug-windows-gcc"
        },
        {
            "name": "release-windows-gcc",
            "configurePreset": "release-windows-gcc"
        },
        {
            "name": "debug-linux-gcc",
            "configurePreset": "debug-linux-gcc"
        },
        {
            "name": "release-linux-gcc",
            "configurePreset": "release-linux-gcc"
        }
    ]
}