{
    "version": 4,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 23,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/bin/${presetName}"
            }
        },
        {
            "name": "gcc",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "debug-gcc",
            "displayName": "Debug (GCC)",
            "inherits": ["base", "gcc"],
            "binaryDir": "${sourceDir}/build/debug-gcc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release-gcc",
            "displayName": "Release (GCC)",
            "inherits": ["base", "gcc"],
            "binaryDir": "${sourceDir}/build/release-gcc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug-gcc",
            "configurePreset": "debug-gcc"
        },
        {
            "name": "release-gcc",
            "configurePreset": "release-gcc"
        }
    ]
}